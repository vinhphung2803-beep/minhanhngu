 },
 {
  "id": "CH1_SC01_DLG004",
  "path": "CHAPTERS[0].intro[1]",
  "ch": "CH1",
  "sc": 1,
  "kind": "DLG",
  "char": "Narrator (lời dẫn)",
  "en": "A first crawl. A first hop.\nA first curious look at the world.",
  "vi": "Lần bò đầu tiên. Cú nhảy đầu tiên.\nLần đầu tò mò nhìn ngắm thế giới.",
  "list": "CHAPTERS[0].intro",
  "idx": 1
 },
 {
  "id": "CH1_SC01_DLG005",
  "path": "CHAPTERS[0].intro[2]",
  "ch": "CH1",
  "sc": 1,
  "kind": "DLG",
  "char": "Narrator (lời dẫn)",
  "en": "Collect stars, hearts and paper planes\non the way. Ready?",
  "vi": "Hãy nhặt sao, trái tim và máy bay giấy\ntrên đường đi. Sẵn sàng chưa?",
  "list": "CHAPTERS[0].intro",
  "idx": 2
 },
 {
  "id": "CH1_SC01_DLG006",
  "path": "CHAPTERS[0].intro[3]",
  "ch": "CH1",
  "sc": 1,
  "kind": "DLG",
  "char": "Narrator (lời dẫn)",
  "en": "",
  "vi": "",
  "list": "CHAPTERS[0].intro",
  "idx": 3
 },
 {
  "id": "CH1_SC02_DLG001",
  "path": "LEVEL_1_HINTS['1']",
  "ch": "CH1",
  "sc": 2,
  "kind": "HNT",
  "char": "Narrator (lời dẫn)",
  "en": "Age 1. Everything is new.\nUse A / D or arrow keys to crawl.",
  "vi": "Tuổi 1. Mọi thứ đều mới lạ.\nDùng A / D hoặc phím mũi tên để bò."
 },
 {
  "id": "CH1_SC02_DLG002",
  "path": "LEVEL_1_HINTS['2']",
  "ch": "CH1",
  "sc": 2,
  "kind": "HNT",
  "char": "Narrator (lời dẫn)",
  "en": "Press SPACE to hop.\nTiny hops, big steps.",
  "vi": "Nhấn SPACE để nhảy.\nBước nhảy nhỏ, bước tiến lớn."
 },
 {
  "id": "CH1_SC02_DLG003",
  "path": "LEVEL_1_HINTS['3']",
  "ch": "CH1",
  "sc": 2,
  "kind": "HNT",
  "char": "Narrator (lời dẫn)",
  "en": "Stars are curiosity.\nHearts are kindness.",
  "vi": "Ngôi sao là sự tò mò.\nTrái tim là lòng tốt."
 },
 {
  "id": "CH1_SC02_DLG004",
  "path": "LEVEL_1_HINTS['4']",
  "ch": "CH1",
  "sc": 2,
  "kind": "HNT",
  "char": "Narrator (lời dẫn)",
  "en": "Paper planes are imagination.\nLook up!",
  "vi": "Máy bay giấy là trí tưởng tượng.\nHãy nhìn lên!"
 },
 {
  "id": "CH1_SC02_DLG005",
  "path": "LEVEL_1_HINTS['5']",
  "ch": "CH1",
  "sc": 2,
  "kind": "HNT",
  "char": "Narrator (lời dẫn)",
  "en": "Almost there.\nStanding up is next.",
  "vi": "Sắp tới rồi.\nTiếp theo là đứng dậy."
 },
