 {
  "id": "CH1_SC01_DLG003",
  "path": "CHAPTERS[0].intro[0]",
  "ch": "CH1",
  "sc": 1,
  "kind": "DLG",
  "char": "Narrator (lời dẫn)",
  "en": "Every story starts small.",
  "vi": "Câu chuyện nào cũng bắt đầu từ những điều nhỏ bé.",
  "list": "CHAPTERS[0].intro",
